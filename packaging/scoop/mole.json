{
    "version": "{{VERSION}}",
    "description": "Deep clean, uninstall apps, optimize, analyze disk, and monitor Windows from the terminal.",
    "homepage": "https://github.com/brummilab/freeMole/tree/windows",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "{{ZIP_URL}}",
            "hash": "{{ZIP_SHA256}}"
        }
    },
    "bin": [
        "fm.exe",
        [
            "fm.exe",
            "mole"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/brummilab/freeMole/releases?per_page=100",
        "regex": "\"tag_name\":\\s*\"V([\\d.]+)-windows\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/brummilab/freeMole/releases/download/V$version-windows/freemole-$version-x64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS.txt"
                }
            }
        }
    }
}
